# Kopeeri see fail nimega .env ja pane sinna OMA paroolid.
# .env on .gitignore'is – paroolid ei satu kunagi repositooriumi.

# Andmebaasi nimi
DB_NAME=ilusalong

# Rakenduse kasutaja (piiratud õigustega, EI OLE root)
DB_USER=lilia_app
DB_PASSWORD=vaheta_see_parool_ara

# MySQL root – ainult hoolduseks (phpMyAdmin)
MYSQL_ROOT_PASSWORD=vaheta_see_root_parool_ara
